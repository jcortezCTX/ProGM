generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// storage_key is an opaque pointer into whatever backend is active - see
// api/src/lib/attachmentStorage.ts, the one module that knows how to read
// it. Local disk for now (CLAUDE.md-style "keep it in one module" rule,
// same as the SharePoint Graph API wiring this table was originally built
// for); graph_drive_id/graph_item_id are left in place, unused, for if/when
// that (or Wasabi, or Google Drive) actually gets wired up.
model attachments {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type    String
  entity_id      String   @db.Uuid
  file_name      String
  content_type   String?
  size_bytes     Int?
  storage_key    String?
  graph_drive_id String?
  graph_item_id  String?
  uploaded_by    String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_attachments_entity")
}

// Asset Tracking module (ccowork/asset-tracking-module-spec.md). Core schema
// only for now — per-asset-type JSON Schemas (valves, pumps, tanks, etc.)
// come later once provided; `generic_asset` is a seeded placeholder type.
// geom/boundary/bounds/default_center are PostGIS geometry columns; Prisma
// has no native type for them, so they're Unsupported and read/written via
// raw SQL ($queryRaw / $executeRaw) in the service layer, same as every
// PostGIS app built on Prisma.
model sites {
  id             String                                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  code           String?                                 @unique
  description    String?
  boundary       Unsupported("geometry(Polygon, 4326)")?
  default_center Unsupported("geometry(Point, 4326)")?
  default_zoom   Int?                                    @db.SmallInt
  timezone       String?
  created_by     String?                                 @db.Uuid
  created_at     DateTime                                @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                                @default(now()) @db.Timestamptz(6)
  users          users?                                  @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  site_layouts   site_layouts[]
  assets         assets[]
}

// The plant drawing overlay. storage_key is resolved through the same
// api/src/lib/attachmentStorage.ts module used by the `attachments` table
// (CLAUDE.md rule 4 — one storage module, not duplicated per feature).
model site_layouts {
  id              String                                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id         String                                  @db.Uuid
  name            String
  storage_key     String
  image_width_px  Int?
  image_height_px Int?
  bounds          Unsupported("geometry(Polygon, 4326)")?
  rotation_deg    Decimal                                 @default(0) @db.Decimal
  opacity         Decimal                                 @default(0.7) @db.Decimal
  z_index         Int                                     @default(0)
  is_active       Boolean                                 @default(true)
  revision        String?
  created_by      String?                                 @db.Uuid
  created_at      DateTime                                @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                                @default(now()) @db.Timestamptz(6)
  sites           sites                                   @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?                                  @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets          assets[]
}

// The registry that drives type-specific fields (CLAUDE.md rule 3 pattern —
// same idea as log_types.field_schema / inventory_custom_field_defs, applied
// to asset attributes). attribute_schema is a JSON Schema, validated on
// write by the application layer, not by Postgres.
model asset_types {
  id                        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                      String        @unique
  name                      String
  category                  String?
  parent_type_id            String?       @db.Uuid
  allowed_geom_types        String[]
  attribute_schema          Json          @default("{\"type\":\"object\",\"properties\":{}}")
  ui_schema                 Json?
  default_useful_life_years Int?
  icon                      String?
  color                     String?
  schema_version            Int           @default(1)
  is_active                 Boolean       @default(true)
  created_at                DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                DateTime      @default(now()) @db.Timestamptz(6)
  asset_types               asset_types?  @relation("asset_types_hierarchy", fields: [parent_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_asset_types         asset_types[] @relation("asset_types_hierarchy")
  assets                    assets[]
}

// Capital assets — points, lines, or polygons on a site's map (spec 2.1: one
// geometry column, mixed geometry types, restricted by the
// assets_geom_type_check constraint and the asset type's allowed_geom_types,
// enforced by the assets_geom_biu trigger). Photos/docs reuse the existing
// polymorphic `attachments` table (entity_type = 'asset') rather than a
// separate asset_attachments table.
model assets {
  id                             String                                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id                        String                                   @db.Uuid
  asset_type_id                  String                                   @db.Uuid
  parent_id                      String?                                  @db.Uuid
  tag                            String
  name                           String
  description                    String?
  geom                           Unsupported("geometry(Geometry, 4326)")?
  geom_type                      String?
  centroid_lat                   Decimal?                                 @db.Decimal(10, 7)
  centroid_lon                   Decimal?                                 @db.Decimal(10, 7)
  elevation_ft                   Decimal?                                 @db.Decimal
  depth_below_grade_ft           Decimal?                                 @db.Decimal
  floor_level                    String?
  layout_id                      String?                                  @db.Uuid
  status                         asset_status                             @default(active)
  condition_rating               Int?                                     @db.SmallInt
  condition_assessed_on          DateTime?                                @db.Date
  criticality                    Int?                                     @db.SmallInt
  manufacturer                   String?
  model                          String?
  serial_number                  String?
  install_date                   DateTime?                                @db.Date
  in_service_date                DateTime?                                @db.Date
  expected_life_years            Int?
  replacement_cost               Decimal?                                 @db.Decimal(14, 2)
  acquisition_cost               Decimal?                                 @db.Decimal(14, 2)
  owner_dept                     String?
  attributes                     Json                                     @default("{}")
  source                         asset_source?
  accuracy_ft                    Decimal?                                 @db.Decimal
  created_by                     String?                                  @db.Uuid
  updated_by                     String?                                  @db.Uuid
  created_at                     DateTime                                 @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                                 @default(now()) @db.Timestamptz(6)
  deleted_at                     DateTime?                                @db.Timestamptz(6)
  sites                          sites                                    @relation(fields: [site_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset_types                    asset_types                              @relation(fields: [asset_type_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  site_layouts                   site_layouts?                            @relation(fields: [layout_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assets                         assets?                                  @relation("assets_hierarchy", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  other_assets                   assets[]                                 @relation("assets_hierarchy")
  users_assets_created_byTousers users?                                   @relation("assets_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_assets_updated_byTousers users?                                   @relation("assets_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset_history                  asset_history[]

  @@unique([site_id, tag])
}

// Append-only audit trail (spec 3.5) — capital asset data feeds financial
// reporting, so change provenance matters. Written by the service layer.
model asset_history {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id      String            @db.Uuid
  change_type   asset_change_type
  field_changes Json
  changed_by    String?           @db.Uuid
  changed_at    DateTime          @default(now()) @db.Timestamptz(6)
  assets        assets            @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?            @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// A vendor order. Not everything on a requisition arrives at once - it's
// fulfilled across multiple partial deliveries over time (see
// requisition_fulfillment, and img/deliveryLog.png for the source workflow).
model requisitions {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requisition_number     String                   @unique
  supplier               String?
  notes                  String?
  created_by             String?                  @db.Uuid
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  users                  users?                   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requisition_line_items requisition_line_items[]
  deliveries             deliveries[]
}

// What was ordered - quantity_ordered is the expected amount; actual receipt
// is tracked separately via delivery_line_items / requisition_fulfillment.
model requisition_line_items {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requisition_id      String                @db.Uuid
  inventory_item_id   String                @db.Uuid
  description         String?
  quantity_ordered    Decimal               @db.Decimal
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  requisitions        requisitions          @relation(fields: [requisition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_items     inventory_items       @relation(fields: [inventory_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery_line_items delivery_line_items[]

  @@index([requisition_id], map: "idx_requisition_line_items_requisition")
}

// A receiving report: one truck/shipment arriving on site, inspected and
// logged against a requisition. Accepted/conditionally-accepted line items
// post `received` inventory transactions; rejected items post nothing.
model deliveries {
  id                         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_number              Int                   @unique @default(autoincrement())
  requisition_id             String?               @db.Uuid
  supplier                   String?
  bill_of_lading_no          String?
  truck_number               String?
  received_date              DateTime              @default(now()) @db.Date
  status                     delivery_status       @default(open)
  accepted_by_supervision    Boolean               @default(false)
  received_in_good_condition Boolean               @default(false)
  conforms_to_specifications Boolean               @default(false)
  qc_notes                   String?
  accepted_by                String?
  created_by                 String?               @db.Uuid
  created_at                 DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  users                      users?                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requisitions               requisitions?         @relation(fields: [requisition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery_line_items        delivery_line_items[]
}

model delivery_line_items {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delivery_id              String                    @db.Uuid
  requisition_line_item_id String?                   @db.Uuid
  inventory_item_id        String                    @db.Uuid
  shipment_number          String?
  description              String?
  quantity_received        Decimal                   @db.Decimal
  condition                String?
  properly_marked          Boolean?
  disposition              delivery_line_disposition @default(accept)
  note                     String?
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  deliveries               deliveries                @relation(fields: [delivery_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requisition_line_items   requisition_line_items?   @relation(fields: [requisition_line_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_items          inventory_items           @relation(fields: [inventory_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_transactions   inventory_transactions[]

  @@index([delivery_id], map: "idx_delivery_line_items_delivery")
  @@index([requisition_line_item_id], map: "idx_delivery_line_items_requisition_line_item")
}

model drawing_revisions {
  id                                                       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drawing_id                                               String     @db.Uuid
  revision_code                                            String
  notes                                                    String?
  external_link                                            String?
  created_by                                               String?    @db.Uuid
  created_at                                               DateTime   @default(now()) @db.Timestamptz(6)
  users                                                    users?     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  drawings_drawing_revisions_drawing_idTodrawings          drawings   @relation("drawing_revisions_drawing_idTodrawings", fields: [drawing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  drawings_drawings_current_revision_idTodrawing_revisions drawings[] @relation("drawings_current_revision_idTodrawing_revisions")

  @@unique([drawing_id, revision_code])
  @@index([drawing_id], map: "idx_drawing_revisions_drawing")
}

model drawings {
  id                                                                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drawing_number                                                    String              @unique
  title                                                             String
  discipline                                                        String?
  drawing_type                                                      String?
  area                                                              String?
  status                                                            drawing_status      @default(draft)
  current_revision_id                                               String?             @db.Uuid
  created_by                                                        String?             @db.Uuid
  created_at                                                        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                                        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  drawing_revisions_drawing_revisions_drawing_idTodrawings          drawing_revisions[] @relation("drawing_revisions_drawing_idTodrawings")
  users                                                             users?              @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  drawing_revisions_drawings_current_revision_idTodrawing_revisions drawing_revisions?  @relation("drawings_current_revision_idTodrawing_revisions", fields: [current_revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_drawings_current_revision")
}

model inventory_items {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                    String                   @unique
  name                   String
  description            String?
  unit                   String                   @default("each")
  reorder_threshold      Decimal                  @default(0) @db.Decimal
  price                  Decimal                  @default(0) @db.Decimal
  notes                  String?
  barcode                String?                  @unique
  product_link           String?
  custom_fields          Json                     @default("{}")
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  delivery_line_items    delivery_line_items[]
  inventory_transactions inventory_transactions[]
  inventory_item_tags    inventory_item_tags[]
  requisition_line_items requisition_line_items[]
}

// Admin-configured template shared by all inventory items - mirrors the
// log_types.field_schema pattern (CLAUDE.md rule 3) rather than hardcoding
// one column per field, since these are meant to be user-defined.
model inventory_custom_field_defs {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_key  String                      @unique
  label      String
  field_type inventory_custom_field_type
  options    Json?
  sort_order Int                         @default(0)
  created_at DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at DateTime                    @default(now()) @db.Timestamptz(6)
}

model inventory_tags {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @unique
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  inventory_item_tags inventory_item_tags[]
}

model inventory_item_tags {
  item_id         String          @db.Uuid
  tag_id          String          @db.Uuid
  inventory_items inventory_items @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_tags  inventory_tags  @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([item_id, tag_id])
}

model inventory_transactions {
  id                    String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id               String                     @db.Uuid
  type                  inventory_transaction_type
  quantity              Decimal                    @db.Decimal
  location              String                     @default("main")
  note                  String?
  delivery_line_item_id String?                    @db.Uuid
  created_by            String?                    @db.Uuid
  created_at            DateTime                   @default(now()) @db.Timestamptz(6)
  users                 users?                     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_items       inventory_items            @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery_line_items   delivery_line_items?       @relation(fields: [delivery_line_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([item_id], map: "idx_inventory_transactions_item")
  @@index([item_id, location], map: "idx_inventory_transactions_item_location")
}

// One row per released tag/spool, mirroring the real "Mechanical Log" Excel
// export (logs_samples/Mechanical Log.csv) column for column - release
// tracking, delivery-vs-need quantities, and contract/invoice pricing go well
// beyond what inventory_items or delivery_line_items model, so this is its
// own typed table rather than shoehorned into either (see BUILD_PLAN.md).
// Deliberately NOT wired into inventory_transactions - unlike the Delivery
// Log, mechanical release tracking here is independent of warehouse stock.
model mechanical_log_items {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  release                 String?
  supplier                String?
  review                  String?
  tag_number              String?
  qty_released            Decimal?  @db.Decimal
  unit                    String?
  size                    String?
  description             String?
  material                String?
  lining                  String?
  coating                 String?
  release_date            DateTime? @db.Date
  due_date                DateTime? @db.Date
  area                    String?
  system                  String?
  contract_dwg            String?
  system2                 String?
  shop_dwg                String?
  delivered_qty           Decimal?  @db.Decimal
  need_qty                Decimal?  @db.Decimal
  received_on             DateTime? @db.Date
  received_by             String?
  storage_location        String?
  notes                   String?
  estimate_cost           Decimal?  @db.Decimal
  contract_unit_price     Decimal?  @db.Decimal
  contract_extended_price Decimal?  @db.Decimal
  above_below             String?
  invoice_no              String?
  invoice_unit_price      Decimal?  @db.Decimal
  invoice_extended_price  Decimal?  @db.Decimal
  delta_invoice_contract  Decimal?  @db.Decimal
  qty_invoiced_to_date    Decimal?  @db.Decimal
  created_by              String?   @db.Uuid
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  users                   users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tag_number], map: "idx_mechanical_log_items_tag_number")
}

// Single-row job config (job number/name, start date, total estimated CY).
// UI always upserts the one row; never store totals/averages derived from
// pours here - only the estimate baseline (see CONCRETE_LOG_SPEC.md).
model concrete_settings {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_number   String
  job_name     String
  start_date   DateTime @db.Date
  total_est_cy Decimal? @db.Decimal
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// Reference data per supplier (from the "Mix Designs" sheet). Pours snapshot
// design_strength_psi at pour time rather than reading it live from here, so
// pass/fail stays stable if a mix design is later edited.
model concrete_mix_designs {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplier            String
  concrete_class      String?
  mix_type            String?
  mix_number          String
  type_of_work        String?
  design_strength_psi Int?
  slump_range         String?
  air_range           String?
  active              Boolean          @default(true)
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  concrete_pours      concrete_pours[]

  @@unique([supplier, mix_number])
}

// From the Summary Sheet's structure column (mostly unpopulated in the real
// workbook - est values are nullable and editable in the UI). Also upserted
// on the fly from distinct pour "Structure" values during import.
model concrete_structures {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @unique
  est_cy         Decimal?         @db.Decimal
  est_cost       Decimal?         @db.Decimal
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  concrete_pours concrete_pours[]
}

// Merges the Excel's two near-identical pour sheets (self-perform vs. subs)
// into one table - is_subcontractor is the only real distinction. Derived
// values (month bucket, over/under required, waste) are computed in the
// service layer, never stored here (CLAUDE.md rule 1 spirit).
model concrete_pours {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pour_date            DateTime              @db.Date
  location             String
  structure_id         String?               @db.Uuid
  mix_design_id        String?               @db.Uuid
  design_strength_psi  Int
  yds_required         Decimal?              @db.Decimal
  yds_delivered        Decimal?              @db.Decimal
  yds_installed        Decimal?              @db.Decimal
  is_subcontractor     Boolean               @default(false)
  poured_by            String?
  invoice_number       String?
  invoice_total        Decimal?              @db.Decimal
  notes                String?
  created_by           String?               @db.Uuid
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  users                users?                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  concrete_structures  concrete_structures?  @relation(fields: [structure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  concrete_mix_designs concrete_mix_designs? @relation(fields: [mix_design_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  concrete_samples     concrete_samples[]

  @@index([pour_date], map: "idx_concrete_pours_pour_date")
  @@index([structure_id], map: "idx_concrete_pours_structure")
}

// Break samples as child rows, not wide "Sample #N" columns - unlimited
// samples per pour, no duplication (see CONCRETE_LOG_SPEC.md). result
// (Pass/Fail) and margin above design are derived, never stored.
model concrete_samples {
  id                          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pour_id                     String         @db.Uuid
  report_number               String?
  seven_day_psi               Decimal?       @db.Decimal
  seven_day_entered_on        DateTime?      @db.Date
  twenty_eight_day_psi        Decimal?       @db.Decimal
  twenty_eight_day_entered_on DateTime?      @db.Date
  notes                       String?
  created_at                  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  concrete_pours              concrete_pours @relation(fields: [pour_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pour_id], map: "idx_concrete_samples_pour")
}

// $/CY is derived (amount / cubic_yards), never stored.
model pump_truck_rentals {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rental_date          DateTime  @db.Date
  location             String
  truck_size_requested String?
  truck_size_sent      String?
  hours                Decimal?  @db.Decimal
  invoice_number       String?
  amount               Decimal?  @db.Decimal
  cubic_yards          Decimal?  @db.Decimal
  date_approved        DateTime? @db.Date
  notes                String?
  created_by           String?   @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  users                users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model concrete_credits {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date_received DateTime  @db.Date
  amount        Decimal   @db.Decimal
  date_approved DateTime? @db.Date
  notes         String?
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  users         users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model log_entries {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  log_type_id String    @db.Uuid
  data        Json
  created_by  String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  log_types   log_types @relation(fields: [log_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([log_type_id], map: "idx_log_entries_log_type")
}

model log_types {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @unique
  slug         String        @unique
  field_schema Json
  created_by   String?       @db.Uuid
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @db.Timestamptz(6)
  log_entries  log_entries[]
  users        users?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model schedule_event_attendees {
  event_id        String            @db.Uuid
  user_id         String            @db.Uuid
  response        attendee_response @default(pending)
  schedule_events schedule_events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([event_id, user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model schedule_events {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String
  description              String?
  location                 String?
  starts_at                DateTime                   @db.Timestamptz(6)
  ends_at                  DateTime                   @db.Timestamptz(6)
  created_by               String?                    @db.Uuid
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  schedule_event_attendees schedule_event_attendees[]
  users                    users?                     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model task_comments {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id    String   @db.Uuid
  author_id  String?  @db.Uuid
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks      tasks    @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id], map: "idx_task_comments_task")
}

model task_lists {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  color      String?
  archived   Boolean  @default(false)
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks      tasks[]
}

model tasks {
  id                            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  list_id                       String           @db.Uuid
  title                         String
  description                   String?
  status                        task_status      @default(to_do)
  priority                      task_priority?
  start_date                    DateTime?        @db.Date
  due_date                      DateTime?        @db.Date
  project                       String?
  category                      String?
  sort_order                    Int              @default(0)
  created_by                    String?          @db.Uuid
  created_at                    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime         @default(now()) @db.Timestamptz(6)
  task_lists                    task_lists       @relation(fields: [list_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_tasks_created_byTousers users?           @relation("tasks_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task_assignees                task_assignees[]
  task_comments                 task_comments[]

  @@index([list_id], map: "idx_tasks_list")
}

model task_assignees {
  task_id String             @db.Uuid
  user_id String             @db.Uuid
  role    task_assignee_role
  tasks   tasks              @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([task_id, user_id, role])
  @@index([user_id], map: "idx_task_assignees_user")
}

model users {
  id                              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  azure_ad_oid                    String?                    @unique
  email                           String                     @unique
  display_name                    String
  role                            user_role                  @default(member)
  // Temporary stopgap until Phase 3 (Azure AD/MSAL) — nullable because
  // Azure AD-provisioned users never get one. See BUILD_PLAN.md working notes.
  password_hash                   String?
  created_at                      DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                   @default(now()) @db.Timestamptz(6)
  attachments                     attachments[]
  sites                           sites[]
  site_layouts                    site_layouts[]
  assets_assets_created_byTousers assets[]                   @relation("assets_created_byTousers")
  assets_assets_updated_byTousers assets[]                   @relation("assets_updated_byTousers")
  asset_history                   asset_history[]
  concrete_credits                concrete_credits[]
  concrete_pours                  concrete_pours[]
  deliveries                      deliveries[]
  drawing_revisions               drawing_revisions[]
  drawings                        drawings[]
  inventory_transactions          inventory_transactions[]
  log_entries                     log_entries[]
  log_types                       log_types[]
  mechanical_log_items            mechanical_log_items[]
  pump_truck_rentals              pump_truck_rentals[]
  requisitions                    requisitions[]
  schedule_event_attendees        schedule_event_attendees[]
  schedule_events                 schedule_events[]
  sessions                        sessions[]
  task_assignees                  task_assignees[]
  task_comments                   task_comments[]
  task_lists                      task_lists[]
  tasks_tasks_created_byTousers   tasks[]                    @relation("tasks_created_byTousers")
}

// Opaque bearer token: the row id itself is the token sent to the client
// (Authorization: Bearer <id>). Revocable by design (delete the row) —
// deliberately not a stateless JWT, so an admin can force a logout later.
model sessions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_sessions_user")
}

view inventory_current_stock {
  item_id          String?  @db.Uuid
  location         String?
  quantity_on_hand Decimal? @db.Decimal
}

// Derived, never stored - same rule as inventory_current_stock. Only accepted
// and conditionally-accepted line items count as received.
view requisition_fulfillment {
  requisition_line_item_id String?  @db.Uuid
  quantity_received        Decimal? @db.Decimal
}

